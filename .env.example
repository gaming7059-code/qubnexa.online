# QUBNEXA - Environment Configuration Template
# Copy to .env and adjust variables as needed for your deployment environment.

# Optional: Base site URL for production canonical metadata and sitemaps (default: https://qubnexa.online)
# VITE_SITE_URL=https://qubnexa.online

# Optional: Base deployment subpath (e.g. / or /subpath/, default: /)
# VITE_BASE_PATH=/

# Google Analytics 4 Measurement ID (default fallback: G-F2NKLZ6T7C)
# VITE_GA_MEASUREMENT_ID=G-F2NKLZ6T7C
